# Server-only connection used by the AEGIS gateway. Never expose this value to
# Codex, Claude, the browser, commits, screenshots, or chat.
#
# It must use the restricted `aegis_gateway` database role created by the
# Supabase migration, not a postgres, service_role, or administrator account.
AEGIS_DATABASE_URL=postgres://aegis_gateway:replace-with-a-unique-local-secret@db.example.supabase.co:5432/postgres?sslmode=require
